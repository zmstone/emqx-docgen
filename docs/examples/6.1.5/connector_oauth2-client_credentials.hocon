authentication = [
  {
    oauth2 {
      enable = true
      token_endpoint = "https://auth.example.com/oauth2/token"
      client_id = "my_client_id"
      client_secret = "my_client_secret"
      scope = "my_scope"
      timeout = "5s"
      ssl {
        #substruct(emqx:ssl_client_opts)
      }
    }
  }
]