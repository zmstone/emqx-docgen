connectors.redis.my_redis_1.parameters{
  servers = "127.0.0.1:6379,127.0.0.2:6379"
  redis_type = sentinel
  sentinel = "my_sentinel_cluster"
  sentinel_username = "sentinel_user"
  sentinel_password = "sentinel_password"
  pool_size = 8
  username = "redis_user"
  password = "redis_password"
  database = 0
}