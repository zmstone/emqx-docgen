cluster.links = [
  {
    name = <<"remote_cluster">>
    server = "remote.example.com:1883"
    clientid = <<"link_client">>
    username = <<"user">>
    password = "file:///path/to/password"
    ssl = {
      #substruct(emqx:ssl_client_opts)
    }
    topics = [<<"t/#">>]
    pool_size = 8
    retry_interval = "15s"
    max_inflight = 32
    tcp_opts = {
      #substruct(emqx:client_tcp_opts)
    }
    resource_opts = {
      #substruct(cluster:creation_opts)
    }
  }
]