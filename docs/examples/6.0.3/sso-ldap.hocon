dashboard.sso.ldap{
  enable = false
  force_mfa = false
  backend = ldap
  query_timeout = "5s"
  server = "ldap.example.com:389"
  pool_size = 8
  username = "user1"
  password = "secret"
  request_timeout = "10s"
  ssl = {
    #substruct(ldap:ssl)
  }
  base_dn = "dc=example,dc=com"
  filter = "(& (objectClass=person) (uid=${username}))"
}