authentication = [
  {
    mechanism = password_based
    backend = ldap
    query_timeout = "5s"
    acl_ttl_attribute = "acl_ttl"
    publish_attribute = "publish"
    subscribe_attribute = "subscribe"
    all_attribute = "all"
    acl_rule_attribute = "acl_rule"
    base_dn = "dc=example,dc=com"
    filter = "(objectClass=mqttUser)"
    precondition = ""
    server = "ldap.example.com:389"
    pool_size = 8
    username = "cn=admin,dc=example,dc=com"
    password = "secret"
    request_timeout = "10s"
    ssl = {
      #substruct(ldap:ssl)
    }
    method = {
      #substruct(authn:hash_method)
      #substruct(authn:bind_method)
    }
  }
]