connectors.confluent_producer.my_confluent_producer.ssl {
  cacertfile = "/etc/ssl/certs/ca-bundle.pem"
  certfile = "/etc/ssl/certs/client-chain.pem"
  keyfile = "/etc/ssl/private/client-key.pem"
  reuse_sessions = true
  depth = 10
  password = "file:///etc/ssl/private/keypass"
  versions = ["tlsv1.3", "tlsv1.2"]
  ciphers = []
  secure_renegotiate = true
  log_level = notice
  hibernate_after = "5s"
  partial_chain = false
  verify_peer_ext_key_usage = "serverAuth,OID:1.3.6.1.5.5.7.3.2"
  middlebox_comp_mode = true
  server_name_indication = auto
}