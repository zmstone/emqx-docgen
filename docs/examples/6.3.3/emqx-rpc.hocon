rpc {
  mode = async
  protocol = tcp
  async_batch_size = 256
  compress_level = 0
  compress_threshold = "1KB"
  port_discovery = stateless
  server_port = 5369
  client_num = 10
  connect_timeout = "5s"
  send_timeout = "5s"
  authentication_timeout = "5s"
  call_receive_timeout = "15s"
  socket_keepalive_idle = "15m"
  socket_keepalive_interval = "75s"
  socket_keepalive_count = 9
  socket_sndbuf = "1MB"
  socket_recbuf = "1MB"
  socket_buffer = "1088KB"
  ciphers = []
  tls_versions = ["tlsv1.3", "tlsv1.2"]
  listen_address = "0.0.0.0"
  ipv6_only = false
}
