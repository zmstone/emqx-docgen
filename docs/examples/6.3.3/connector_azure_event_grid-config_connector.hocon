connectors.azure_event_grid.my_azure_event_grid_1 {
  ssl = {enable = true}
  pool_size = 8
  resource_opts = {
    #substruct(connector_mqtt:resource_opts)
  }
  server = "broker.emqx.io:1883"
  clientid_prefix = "myclient"
  static_clientids = []
  proto_ver = v4
  bridge_mode = false
  username = "user1"
  password = "secret"
  clean_start = true
  keepalive = "160s"
  connect_timeout = "10s"
  retry_interval = "15s"
  max_inflight = 32
  tcp_opts = {
    #substruct(emqx:client_tcp_opts)
  }
}