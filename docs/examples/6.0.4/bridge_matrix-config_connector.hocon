connectors.matrix.my_connector {
  server = "db.example.com:5432"
  disable_prepared_statements = false
  database = "my_database"
  pool_size = 8
  username = "db_user"
  password = "file:///path/to/password"
  ssl = {
    #substruct(emqx:ssl_client_opts)
  }
  tags = ["tag1", "tag2"]
  resource_opts = {
    #substruct(connector_postgres:resource_opts)
  }
}