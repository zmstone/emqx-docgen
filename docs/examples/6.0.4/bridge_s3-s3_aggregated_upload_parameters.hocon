actions.s3.my_webhook_1.parameters {
  mode = aggregated
  container = {
    #substruct(connector_aggregator:container_csv)
    #substruct(connector_aggregator:container_json_lines)
  }
  aggregation = {
    #substruct(bridge_s3:s3_aggregation)
  }
  bucket = "my-bucket"
  key = "year=${datetime.YYYY}/month=${datetime.MM}/day=${datetime.DD}/${action}_${node}_N${sequence}.json"
  acl = private
  headers = {}
  min_part_size = "5mb"
  max_part_size = "5gb"
}