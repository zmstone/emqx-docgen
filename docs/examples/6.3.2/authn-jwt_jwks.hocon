authentication = [
  {
    use_jwks = true
    endpoint = "https://example.com/jwks"
    headers = {Accept = "application/json"}
    pool_size = 8
    refresh_interval = 300
    ssl = {
      #substruct(authn:jwks_client_ssl_opts)
    }
    mechanism = jwt
    acl_claim_name = "acl"
    on_missing_jwt = ignore
    verify_claims = {}
    disconnect_after_expire = true
    from = password
    precondition = ""
  }
]